{
  "id": "/",
  "name": "RUCA Command Core Public Simulation",
  "short_name": "RUCA",
  "description": "A self-contained, controller-first RUCA product simulation using deterministic local data.",
  "start_url": "/index.html#home",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#030304",
  "theme_color": "#070506",
  "categories": ["entertainment", "utilities", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "RUCA Home", "short_name": "Home", "url": "/index.html#home", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "RUCA Play", "short_name": "Play", "url": "/index.html#play", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "RUCA Diagnostics", "short_name": "Diagnostics", "url": "/index.html#diagnostics", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "RUCA Case Study", "short_name": "Case Study", "url": "/portfolio/", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
