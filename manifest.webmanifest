{
  "id": "./index.html",
  "name": "RUCA Mobile Demo",
  "short_name": "RUCA Demo",
  "description": "A safe, offline-ready RUCA portable showroom containing the product demo, portfolio, and resume project entry.",
  "start_url": "./index.html#home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#030405",
  "theme_color": "#050607",
  "categories": ["entertainment", "utilities", "productivity"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Welcome Home",
      "short_name": "Home",
      "url": "./index.html#home",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Command Search",
      "short_name": "Search",
      "url": "./index.html#search",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "RUCA Portfolio",
      "short_name": "Portfolio",
      "url": "./portfolio/index.html",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Anthony Moncion Resume",
      "short_name": "Resume",
      "url": "./portfolio/index.html#resume",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
