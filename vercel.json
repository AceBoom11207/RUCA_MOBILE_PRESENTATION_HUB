{
  "alias": ["ruca-mobile-presentation-hub.vercel.app"],
  "redirects": [
    { "source": "/", "destination": "/portfolio/", "permanent": false }
  ],
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/portfolio/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/demo/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/mobile-showcase/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/resume/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/service-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=()" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
    ] }
  ]
}
